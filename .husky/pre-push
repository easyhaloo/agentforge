#!/usr/bin/env bash
#
# Git pre-push hook: Check documentation, code quality, and tests
#
# This hook runs:
# 1. Documentation placement check (per CLAUDE.md rules)
# 2. Go code formatting check (gofmt)
# 3. Go unit/integration tests
# 4. Frontend unit tests (Vitest)
# 5. Frontend build check (TypeScript + Vite)
# 6. E2E tests (Playwright) - auto-installs missing browsers; optional via SKIP_E2E=1
#
# If any check fails, the push is rejected.
#
# Managed manually (no npm package dependency)
# Bypass all checks: git push --no-verify
# Skip E2E only: SKIP_E2E=1 git push

set -e

# Change to repo root
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 1. Check documentation placement
if [ -x "$REPO_ROOT/.husky/check-doc-placement" ]; then
    "$REPO_ROOT/.husky/check-doc-placement" "$@"
fi

echo ""
echo "🔍 Checking Go code formatting..."

cd "$REPO_ROOT/backend/api"

# Check for unformatted Go files
UNFORMATTED=$(gofmt -l . 2>&1)

if [ -n "$UNFORMATTED" ]; then
    echo ""
    echo -e "${RED}❌ Go code formatting check failed!${NC}"
    echo ""
    echo "The following files are not formatted correctly:"
    echo "$UNFORMATTED"
    echo ""
    echo "Please run 'gofmt -w .' in backend/api to format your code."
    echo "Or run: cd backend/api && gofmt -w ."
    echo ""
    echo "To bypass this check (not recommended): git push --no-verify"
    exit 1
fi

echo -e "${GREEN}✅ All Go files are properly formatted${NC}"

echo ""
echo "🧪 Running Go tests..."

# Git exports GIT_DIR (and friends) to the hook, so every git command the tests
# run would act on this repository instead of the temporary repositories they
# create, and they fail with "this operation must be run in a work tree".
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# Run Go tests
if ! go test ./... 2>&1; then
    echo ""
    echo -e "${RED}❌ Go tests failed!${NC}"
    echo ""
    echo "Please fix the failing tests before pushing."
    echo "Run 'go test ./...' in backend/api to see detailed errors."
    echo ""
    echo "To bypass this check (not recommended): git push --no-verify"
    exit 1
fi

echo -e "${GREEN}✅ All Go tests passed${NC}"

# Switch to frontend
cd "$REPO_ROOT/apps/web"

echo ""
echo "🧪 Running frontend unit tests..."

# Run frontend unit tests
if ! npm test 2>&1; then
    echo ""
    echo -e "${RED}❌ Frontend unit tests failed!${NC}"
    echo ""
    echo "Please fix the failing tests before pushing."
    echo "Run 'cd apps/web && npm test' to see detailed errors."
    echo ""
    echo "To bypass this check (not recommended): git push --no-verify"
    exit 1
fi

echo -e "${GREEN}✅ All frontend unit tests passed${NC}"

echo ""
echo "🏗️  Checking frontend build..."

# Run frontend build check (TypeScript + Vite)
if ! npm run build 2>&1; then
    echo ""
    echo -e "${RED}❌ Frontend build failed!${NC}"
    echo ""
    echo "Please fix the build errors before pushing."
    echo "Run 'cd apps/web && npm run build' to see detailed errors."
    echo ""
    echo "To bypass this check (not recommended): git push --no-verify"
    exit 1
fi

echo -e "${GREEN}✅ Frontend build successful${NC}"

# E2E tests (optional via SKIP_E2E=1)
if [ "${SKIP_E2E}" = "1" ]; then
    echo ""
    echo -e "${YELLOW}⚠️  E2E tests skipped (SKIP_E2E=1)${NC}"
    echo "   Remember to run 'cd apps/web && npm run test:e2e' before merging to main"
else
    echo ""
    echo "🎭 Running E2E tests (Playwright)..."
    echo "   (Skip with: SKIP_E2E=1 git push)"

    # Self-heal the browser dependency. Playwright pins an exact browser build,
    # so a version bump makes the local cache stale and every E2E test fails
    # instantly at browserType.launch. Detect it by really launching once,
    # then install the pinned browser only when needed.
    echo ""
    echo "🔎 Checking Playwright browser..."
    PW_PROBE='const { chromium } = require("playwright"); chromium.launch().then(b => b.close()).catch(() => process.exit(1))'
    if ! node -e "$PW_PROBE" >/dev/null 2>&1; then
        echo -e "${YELLOW}⚠️  Playwright browser missing or not launchable; installing it now...${NC}"
        # The installer's exit code is not the source of truth: it may fail
        # after downloading successfully (e.g. while cleaning temp files).
        # The launch probe below decides whether setup really succeeded.
        if ! npx playwright install chromium 2>&1; then
            echo -e "${YELLOW}⚠️  Installer reported an error; checking browser anyway...${NC}"
        fi
        # Verify the browser actually works before running the whole suite.
        if ! node -e "$PW_PROBE" >/dev/null 2>&1; then
            echo ""
            echo -e "${RED}❌ Playwright browser still not launchable after install${NC}"
            echo ""
            echo "Run manually: cd apps/web && npx playwright install chromium"
            echo "On Linux, system libraries may be missing: npx playwright install --with-deps chromium"
            echo "Or skip E2E for this push: SKIP_E2E=1 git push"
            exit 1
        fi
        echo -e "${GREEN}✅ Playwright browser installed and ready${NC}"
    else
        echo -e "${GREEN}✅ Playwright browser ready${NC}"
    fi

    # Run E2E tests (already in apps/web directory)
    if ! npm run test:e2e 2>&1; then
        echo ""
        echo -e "${RED}❌ E2E tests failed!${NC}"
        echo ""
        echo "Please fix the failing E2E tests before pushing."
        echo "Run 'cd apps/web && npm run test:e2e' to see detailed errors."
        echo ""
        echo "To skip E2E temporarily: SKIP_E2E=1 git push"
        echo "To bypass all checks (not recommended): git push --no-verify"
        exit 1
    fi

    echo -e "${GREEN}✅ All E2E tests passed${NC}"
fi

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ All pre-push checks passed!${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
exit 0
