{
  "name": "agentforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @agentforge/web",
    "build": "npm run build --workspace @agentforge/web",
    "test": "npm run test --workspace @agentforge/web",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "husky": "^9.1.7",
    "wrangler": "4.163.0"
  }
}
