#!/usr/bin/env bash
#
# Git pre-push hook: Run formatting checks and tests before push
#
# This hook ensures code quality by running:
# 1. Go code formatting check (gofmt)
# 2. Full test suite (backend + frontend)
#
# Install: ./scripts/install-git-hooks.sh
# Bypass: git push --no-verify (NOT RECOMMENDED)

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "🔍 Running pre-push checks..."
echo ""

# ==============================================================================
# 1. Go Code Formatting Check
# ==============================================================================
echo "📝 Checking Go code formatting..."

cd "$REPO_ROOT/backend/api"

UNFORMATTED=$(gofmt -l . 2>&1)

if [ -n "$UNFORMATTED" ]; then
    echo ""
    echo "❌ Go code formatting check failed!"
    echo ""
    echo "The following files are not formatted correctly:"
    echo "$UNFORMATTED"
    echo ""
    echo "Please run: cd backend/api && gofmt -w ."
    echo ""
    echo "To bypass (not recommended): git push --no-verify"
    exit 1
fi

echo "✅ Go code formatting passed"
echo ""

# ==============================================================================
# 2. Backend Tests
# ==============================================================================
echo "🧪 Running backend tests..."

cd "$REPO_ROOT/backend/api"

# Check if DATABASE_URL is set
if [ -z "$DATABASE_URL" ]; then
    echo ""
    echo "❌ DATABASE_URL is not set!"
    echo ""
    echo "Backend tests require a PostgreSQL database."
    echo ""
    echo "Options:"
    echo "  1. Start database: make dev (in another terminal)"
    echo "  2. Set DATABASE_URL manually:"
    echo "     export DATABASE_URL='postgres://agentforge:agentforge@localhost:5432/agentforge_test?sslmode=disable'"
    echo ""
    echo "To bypass (NOT RECOMMENDED): git push --no-verify"
    exit 1
fi

# Run Go tests
if ! go test ./...; then
    echo ""
    echo "❌ Backend tests failed!"
    echo ""
    echo "Please fix failing tests before pushing."
    echo ""
    echo "To bypass (NOT RECOMMENDED): git push --no-verify"
    exit 1
fi

echo "✅ Backend tests passed"
echo ""

# ==============================================================================
# 3. Frontend Tests (if apps/web exists)
# ==============================================================================
if [ -d "$REPO_ROOT/apps/web" ]; then
    echo "🧪 Running frontend tests..."

    cd "$REPO_ROOT/apps/web"

    # Run npm test
    if ! npm test -- --run; then
        echo ""
        echo "❌ Frontend tests failed!"
        echo ""
        echo "Please fix failing tests before pushing."
        echo ""
        echo "To bypass (NOT RECOMMENDED): git push --no-verify"
        exit 1
    fi

    echo "✅ Frontend tests passed"
    echo ""
fi

# ==============================================================================
# All checks passed
# ==============================================================================
echo "🎉 All pre-push checks passed!"
echo ""

exit 0
