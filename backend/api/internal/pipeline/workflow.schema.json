{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "apiVersion",
    "name",
    "stages"
  ],
  "properties": {
    "apiVersion": {
      "const": "agentforge.dev/v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "type": {
            "enum": [
              "string",
              "boolean",
              "number",
              "integer",
              "choice",
              "branch",
              "branches",
              "repository",
              "secretRef"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "override": {
            "type": "boolean"
          },
          "default": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "maxItems": 64
          }
        },
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "jobs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "dependsOn": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "uniqueItems": true,
            "maxItems": 64
          },
          "jobs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "steps"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "uses"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                      },
                      "secretParams": {
                        "type": "array", "uniqueItems": true, "maxItems": 16,
                        "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }
                      },
                      "script": { "type": "string", "minLength": 1, "maxLength": 16384 },
                      "outputs": { "type": "array", "uniqueItems": true, "maxItems": 16,
                        "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" } },
                      "uses": {
                        "enum": ["control/approval@v1", "container/check@v1", "container/script@v1"]
                      }
                    },
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 64
                }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 64
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "additionalProperties": false
}
