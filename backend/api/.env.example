PORT=8080
DATABASE_URL=postgres://agentforge:agentforge@localhost:5432/agentforge?sslmode=disable
APP_ORIGIN=http://localhost:5173

# Optional OIDC configuration. Set all four values to enable login.
# The redirect URL must exactly match the callback registered with the provider.
# OIDC_ISSUER_URL=https://identity.example.com
# OIDC_CLIENT_ID=agentforge
# OIDC_CLIENT_SECRET=replace-with-secret
# OIDC_REDIRECT_URL=https://api.example.com/auth/oidc/callback
# SESSION_TTL=12h

# Optional local Git provider. Repositories are provisioned by an operator at:
# GIT_REPOSITORY_ROOT/<organization-id>/<owner>/<repository>
# The API never clones arbitrary user-supplied URLs or executes repository hooks.
# GIT_REPOSITORY_ROOT=/var/lib/agentforge/git

# Required to persist evaluation reports as content-addressed, immutable artifacts.
# EVIDENCE_ROOT=/var/lib/agentforge/evidence
